# Environment of deploy/deploy.sh, on the machine that deploys. Copy outside the repository,
# fill in, `set -a; . that-file; set +a`. Never commit it. Single-quote the accounts: bcrypt
# hashes contain `$`.
# ssh destination of the VPS, user@address: the --deploy-user of bootstrap.sh at the server's
# main address (--main-ip), never the site's host (on a server with two addresses ssh does
# not answer on the site's; with one, both are the same address, still by address here).
DEPLOY_TARGET=
DEPLOY_PATH=/srv/preview # releases live under it; the web root is $DEPLOY_PATH/current
CADDY_SITE=/etc/caddy/sites.d/preview.caddy
PREVIEW_HOST=            # the site's host (the preview: <random>.<domain>, `openssl rand -hex 6`)
# preview: every path behind the password (PREVIEW_ACCOUNTS), never indexed; public: open
# and indexable, /revue and its API alone behind a password (REVIEW_ACCOUNTS).
SITE_MODE=preview
# Words of this deployment that nothing answered without the password may contain, beside
# the project's names (deploy/site.py check), comma-separated, case-insensitive: a brand or
# a domain the repository never names.
SITE_FORBIDDEN=
# public mode: the site's own IPv4, the one Caddy listens on (bootstrap.sh --bind-ip); the
# deploy's check wants it as the only A record of the host and of www.<host> (which the site
# file redirects for good to the host), and no AAAA record for either.
SITE_IP=
# The gate of the preview: one basic-auth user per tester, "name hash;name hash" (hashes
# from `caddy hash-password`). Not the API's accounts: those sign in on the site and are
# created on the server with `python -m lacarte.api.accounts` (README, « Accounts »).
PREVIEW_ACCOUNTS=''
# public mode: the password of /revue and its API, in front of the reviewer's own account;
# same form as PREVIEW_ACCOUNTS.
REVIEW_ACCOUNTS=''
API_PORT=8791            # the API on 127.0.0.1 (the same as bootstrap.sh --api-port)
# Test accounts, comma-separated pseudonyms (any case): their contributions are stored
# and shown as proposals, marked "test" in /revue, out of the leaderboard, never exported;
# the deploy flags them (db/test_authors.sh) and refuses an export holding one (lacarte
# contrib check-test).
TEST_AUTHORS=
# The address « Me contacter » writes to (asking for an account, a forgotten password):
# built into the web page (VITE_CONTACT_EMAIL). Required by deploy.sh; never in the repo.
CONTACT_EMAIL=
# Sign in with OpenStreetMap (README, « Sign in with OpenStreetMap »): the applications
# registered on the live server (openid) and on the dev server (a later lot writes there),
# confidential; their id and secret as OSM shows them. Required by deploy.sh, which writes
# them to <DEPLOY_PATH>/api/osm.env (600) for the API; never printed, never in the repo.
OSM_LIVE_CLIENT_ID=
OSM_LIVE_CLIENT_SECRET=
OSM_DEV_CLIENT_ID=
OSM_DEV_CLIENT_SECRET=
# The write tokens' key, 32 random bytes: `openssl rand -base64 32`.
OSM_TOKEN_KEY=
# Where the OSM synchronisation writes: dev (master.apis.dev.openstreetmap.org), the only
# value. Writing to the live server is /revue's « Réglages » switch (an administrator, with
# the live client above), no redeploy; OSM_WRITE_LIVE_APPROVED is no longer read.
OSM_WRITE_SERVER=dev
# Read by the API at its start (<DEPLOY_PATH>/api/site.env, written by deploy.sh; the deploy
# user may change it there and restart the API): the identity shown if given (free text,
# one line; single-quote it). Never printed. Contributions and sign-ups open or closed are
# no longer set here: /revue's « Réglages » (an administrator), kept in the database; a
# CONTRIBUTIONS_OPEN left here is ignored.
PUBLISHER_IDENTITY=
# Which server this file deploys: "preview" for the private preview, "public" for the public
# site. deploy.sh only wants it set; db/reset_contributions.sh refuses anything but preview.
STAGE=preview
