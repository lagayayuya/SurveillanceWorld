#!/bin/sh
# Stands for iproute2's `ip -4 -o addr show scope global` in tests/test_deploy.py: one line
# per address of FAKE_IPS (space-separated), as Debian 13's ip prints them.
n=2
for a in $FAKE_IPS; do
  printf '%s: eth0    inet %s/24 brd 192.0.2.255 scope global eth0\\       valid_lft forever preferred_lft forever\n' "$n" "$a"
  n=$((n + 1))
done
